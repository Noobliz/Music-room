{
  "name": "@music-room/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync-local-config": "sh scripts/sync-supabase-config.sh",
    "db:start": "pnpm sync-local-config && supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.2",
    "supabase": "^2.39.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
