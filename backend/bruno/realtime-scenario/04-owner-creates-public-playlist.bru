meta {
  name: Owner creates a public playlist
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/spaces
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ownerToken}}
}

body:json {
  {
    "kind": "playlist",
    "name": "{{spaceName}}"
  }
}

script:pre-request {
  bru.setVar("spaceName", `bruno-realtime-${Date.now()}`);
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("spaceId", res.body.id);
  }
}

tests {
  test("returns HTTP 201 with version 1", () => {
    expect(res.status).to.equal(201);
    expect(res.body.version).to.equal(1);
  });
}
