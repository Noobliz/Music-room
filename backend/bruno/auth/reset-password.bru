meta {
  name: Reset password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/password/reset
  body: json
  auth: none
}

body:json {
  {
    "tokenHash": "{{tokenHash}}",
    "password": "{{password}}"
  }
}

tests {
  test("returns HTTP 204", () => {
    expect(res.status).to.equal(204);
  });
}
