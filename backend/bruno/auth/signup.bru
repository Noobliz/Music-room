meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "username": "{{username}}"
  }
}

tests {
  test("returns HTTP 201, or 409 if the username is taken", () => {
    expect([201, 409]).to.include(res.status);
  });
}
