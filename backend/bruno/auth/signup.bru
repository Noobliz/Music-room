meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "username": "{{username}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("accessToken", res.body.session.accessToken);
    bru.setVar("refreshToken", res.body.session.refreshToken);
  }
}

tests {
  test("returns HTTP 201, or 409 if the account already exists", () => {
    expect([201, 409]).to.include(res.status);
  });
}
