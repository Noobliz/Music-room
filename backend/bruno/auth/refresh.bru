meta {
  name: Refresh
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.session.accessToken);
    bru.setVar("refreshToken", res.body.session.refreshToken);
  }
}

tests {
  test("returns HTTP 200", () => {
    expect(res.status).to.equal(200);
  });
}
