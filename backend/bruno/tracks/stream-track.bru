meta {
  name: Get a link to play a track
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/tracks/{{trackId}}/stream
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("returns HTTP 200 with a signed URL", () => {
    expect(res.status).to.equal(200);
    expect(res.body.url).to.be.a("string");
  });
}
