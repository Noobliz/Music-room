meta {
  name: Friend proposes without sending a position
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/spaces/{{zoneSpaceId}}/proposals
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{friendToken}}
}

body:json {
  {
    "trackId": "{{zoneTrackId}}"
  }
}

tests {
  test("the proposal is refused with POSITION_REQUIRED", () => {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal("POSITION_REQUIRED");
  });
}
