meta {
  name: Friend removes their vote after the slot
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/spaces/{{zoneSpaceId}}/proposals/{{zoneProposalId}}/vote
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{friendToken}}
}

body:json {
  {
    "position": { "latitude": 48.8971, "longitude": 2.3192 }
  }
}

tests {
  test("the request is refused with VOTE_ENDED", () => {
    expect(res.status).to.equal(403);
    expect(res.body.error.code).to.equal("VOTE_ENDED");
  });
}
