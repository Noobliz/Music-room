meta {
  name: Friend reads both votes
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/spaces/{{zoneSpaceId}}/queue
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{friendToken}}
}

tests {
  test("both votes are counted", () => {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.have.lengthOf(1);
    expect(res.body.items[0]).to.include({ id: bru.getVar("zoneProposalId"), voteCount: 2, hasVoted: true });
  });
}
