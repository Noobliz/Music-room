meta {
  name: Invite a friend
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/spaces/{{spaceId}}/invitations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "userId": "{{friendUserId}}"
  }
}

tests {
  test("returns HTTP 201", () => {
    expect(res.status).to.equal(201);
  });
}
