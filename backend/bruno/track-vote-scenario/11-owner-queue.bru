meta {
  name: owner reads the remaining vote
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/spaces/{{voteSpaceId}}/queue
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{ownerToken}}
}

tests {
  test("the owner sees one vote and their own voting state", () => {
    expect(res.status).to.equal(200);
    expect(res.body.version).to.equal(5);
    expect(res.body.items).to.have.lengthOf(1);
    expect(res.body.items[0]).to.include({ id: bru.getVar("voteProposalId"), voteCount: 1, hasVoted: true });
  });
}
