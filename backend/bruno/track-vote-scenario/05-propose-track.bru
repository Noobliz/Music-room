meta {
  name: Owner proposes the selected track
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/spaces/{{voteSpaceId}}/proposals
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ownerToken}}
}

body:json {
  {
    "trackId": "{{voteTrackId}}"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("voteProposalId", res.body.id);
}

tests {
  test("a proposal is created", () => {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
  });
}
