meta {
  name: Get my profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/profiles/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("profileId", res.body.id);
  }
}

tests {
  test("returns HTTP 200", () => {
    expect(res.status).to.equal(200);
  });
}
