meta {
  name: Friend lost access after leaving
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/spaces/{{spaceId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{friendToken}}
}

tests {
  test("returns HTTP 404", () => {
    expect(res.status).to.equal(404);
  });

  test("returns SPACE_NOT_FOUND", () => {
    expect(res.body.error.code).to.equal("SPACE_NOT_FOUND");
  });
}
