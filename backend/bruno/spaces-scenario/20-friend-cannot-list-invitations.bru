meta {
  name: Invited friend cannot list invitations
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/spaces/{{spaceId}}/invitations
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{friendToken}}
}

tests {
  test("returns HTTP 403", () => {
    expect(res.status).to.equal(403);
  });

  test("returns NOT_SPACE_OWNER", () => {
    expect(res.body.error.code).to.equal("NOT_SPACE_OWNER");
  });
}
