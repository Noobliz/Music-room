meta {
  name: Owner cannot invite a non-friend
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/spaces/{{spaceId}}/invitations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ownerToken}}
}

body:json {
  {
    "userId": "{{friendUserId}}"
  }
}

tests {
  test("returns HTTP 403", () => {
    expect(res.status).to.equal(403);
  });

  test("returns INVITEE_NOT_FRIEND", () => {
    expect(res.body.error.code).to.equal("INVITEE_NOT_FRIEND");
  });
}
