meta {
  name: Invited friend opens and can act in the private space
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/spaces/{{spaceId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{friendToken}}
}

tests {
  test("returns HTTP 200", () => {
    expect(res.status).to.equal(200);
  });

  test("can act as invited", () => {
    expect(res.body.myRole).to.equal("invited");
    expect(res.body.canAct).to.equal(true);
  });
}
