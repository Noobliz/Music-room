meta {
  name: Owner makes the space private
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/spaces/{{spaceId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ownerToken}}
}

body:json {
  {
    "visibility": "private"
  }
}

tests {
  test("returns HTTP 200", () => {
    expect(res.status).to.equal(200);
  });

  test("is private", () => {
    expect(res.body.visibility).to.equal("private");
  });
}
