meta {
  name: Owner logs in
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("ownerToken", res.body.session.accessToken);
    bru.setVar("ownerId", res.body.user.id);
  }
}

tests {
  test("returns HTTP 200", () => {
    expect(res.status).to.equal(200);
  });
}
