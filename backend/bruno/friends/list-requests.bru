meta {
  name: List my friend requests
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/friends/requests
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.status === 200 && res.body.received.length > 0) {
    bru.setVar("friendRequestId", res.body.received[0].id);
  }
}

tests {
  test("returns HTTP 200", () => {
    expect(res.status).to.equal(200);
  });
}
