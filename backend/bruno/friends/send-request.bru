meta {
  name: Send a friend request
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/friends/requests
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "userId": "{{friendUserId}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("friendRequestId", res.body.id);
  }
}

tests {
  test("returns HTTP 201", () => {
    expect(res.status).to.equal(201);
  });
}
